{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hy/sciverse/contracts/evidence-record.schema.json",
  "title": "Sciverse Evidence Record",
  "description": "A source-preserving handoff record produced by sciverse-research for downstream Skills.",
  "type": "object",
  "required": [
    "title",
    "evidence",
    "inference",
    "provenance"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "inference": {
      "type": "string"
    },
    "uncertainty": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unique_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "doc_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chunk_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "page_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "paper_schema": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "partial": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "truncated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
